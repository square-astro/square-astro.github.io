---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="footer-brand">
    <img class="brand-mark brand-mark-light" src={`${base}/images/square-symbol.png`} alt="" aria-hidden="true" />
    <div>
      <strong>SQuARE</strong>
      <p>Survey-based Quasar Analysis and Research for Evolution</p>
    </div>
  </div>
  <div class="footer-links">
    <a href={`${base}/research/`}>Research</a>
    <a href={`${base}/people/`}>People</a>
    <a href={`${base}/publications/`}>Publications</a>
  </div>
  <div class="footer-contact">
    <p>Department of Physics and Astronomy<br />Sejong University · Seoul, Korea</p>
    <a href="mailto:yongjungkim@sejong.ac.kr">yongjungkim@sejong.ac.kr ↗</a>
  </div>
  <p class="footer-meta">© {new Date().getFullYear()} SQuARE Group</p>
</footer>
