---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import researchTopics from '../data/research.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = researchTopics;
---

<SiteLayout title="Research — SQuARE" description="Research themes of the SQuARE Group at Sejong University.">
  <Header />
  <main>
    <PageHero
      eyebrow="Research"
      title="Our research areas."
      accent="research areas."
      intro="We use wide-area optical and infrared surveys to study quasar populations, obscured accretion, and the near-infrared sky with SPHEREx."
    />
    <section class="research-topics">
      {topics.map((topic, index) => (
        <article class={`topic-block ${index % 2 === 1 ? 'topic-block-reverse' : ''}`}>
          <div class="topic-copy">
            <p class="topic-number">{topic.number}</p>
            <h2>{topic.title}</h2>
            <p>{topic.text}</p>
            <div class="topic-tags">
              {topic.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <div class={`topic-media ${topic.images.length === 1 ? 'topic-media-single' : ''}`}>
            {topic.images.map((image) => (
              <figure class="topic-figure">
                <div class={`topic-image-frame topic-image-${image.fit}`}>
                  <img src={`${base}${image.src}`} alt={image.alt} loading="lazy" />
                </div>
                <figcaption>
                  <span>{image.caption}</span>
                  <a href={image.sourceUrl} target="_blank" rel="noreferrer">
                    {image.source} <span aria-hidden="true">↗</span>
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</SiteLayout>
