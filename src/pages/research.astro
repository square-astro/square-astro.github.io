---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import researchTopics from '../data/research.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = researchTopics;
---

<SiteLayout title="Research — SQuARE" description="Research themes of the SQuARE Group at Sejong University.">
  <Header />
  <main>
    <PageHero
      eyebrow="Research"
      title="Our research areas."
      accent="research areas."
      intro="We use wide-area surveys and multi-wavelength observations to understand the origin, demographics, and environments of quasars — from the nearby universe to cosmic dawn."
    />
    <section class="research-topics">
      {topics.map((topic, index) => (
        <article class={`topic-block ${index % 2 === 1 ? 'topic-block-reverse' : ''}`}>
          <div class="topic-copy">
            <p class="topic-number">{topic.number}</p>
            <h2>{topic.title}</h2>
            <p>{topic.text}</p>
            <div class="topic-tags">
              {topic.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <figure class={`topic-figure ${topic.image ? '' : 'topic-figure-empty'}`}>
            {topic.image && <img src={`${base}${topic.image}`} alt={topic.alt} loading="lazy" />}
            {topic.caption && <figcaption>{topic.caption}</figcaption>}
          </figure>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</SiteLayout>
