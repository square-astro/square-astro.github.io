---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import members from '../data/members.json';
import publicationOverrides from '../data/publication-overrides.json';
import bibSource from '../data/publications.bib?raw';
import { formatAuthors, parseBibTeX } from '../lib/bibtex';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentMembers = members.filter((member) => member.status === 'current').sort((a, b) => a.order - b.order);
const groupAuthorNames = members.flatMap((member) => member.publicationNames);
const selectedPubs = parseBibTeX(bibSource, publicationOverrides).filter((publication) => publication.selected).slice(0, 3);
const research = [
  {
    number: '01',
    title: 'Quasar populations across cosmic time',
    text: 'We build wide-area quasar samples and trace how their abundance and luminosity evolve across cosmic time.',
  },
  {
    number: '02',
    title: 'Obscured quasars & black-hole growth',
    text: 'We use optical and infrared observations to study red and dust-obscured quasars and their accretion activity.',
  },
  {
    number: '03',
    title: 'SPHEREx survey science',
    text: 'We develop methods to study quasars and galaxies with SPHEREx all-sky near-infrared spectrophotometry.',
  },
];

function period(start: string, end: string | null) {
  const display = (value: string) => value.replace('-', '.');
  return `${display(start)} — ${end ? display(end) : 'present'}`;
}
---

<SiteLayout>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Sejong University · Seoul</p>
        <h1>Reading cosmic history through <em>quasars.</em></h1>
        <p class="hero-lede">
          Survey-based Quasar Analysis and Research for Evolution — exploring how
          quasars, black holes, and galaxies change across cosmic time.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${base}/research/`}>Explore our research <span>↘</span></a>
          <a class="text-link" href={`${base}/people/`}>Meet the group <span>→</span></a>
        </div>
      </div>
      <div class="hero-visual">
        <img src={`${base}/images/square-logo.png`} alt="SQuARE group emblem" />
      </div>
    </section>

    <section class="research-intro section-pad" id="research">
      <div class="section-heading">
        <p class="eyebrow"><span></span> Our research</p>
        <h2>Quasars, black-hole growth, and the infrared sky.</h2>
      </div>
      <p class="section-summary">
        We combine large optical and infrared datasets with statistical methods
        to study quasar populations, dust-obscured accretion, and new observations from SPHEREx.
      </p>
    </section>

    <section class="research-grid" aria-label="Research themes">
      {research.map((item) => (
        <a class="research-card" href={`${base}/research/`}>
          <p class="card-number">{item.number}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </section>

    <section class="people-preview section-pad" id="people">
      <div class="people-intro">
        <p class="eyebrow"><span></span> People</p>
        <h2>Members of the SQuARE group.</h2>
        <a class="text-link" href={`${base}/people/`}>Meet everyone <span>→</span></a>
      </div>
      <div class="member-preview-grid">
        {currentMembers.map((member) => (
          <article class={`member-card ${member.role === 'Principal Investigator' ? 'member-card-featured' : ''}`}>
            <div class="member-image">
              {member.photo ? (
                <img src={`${base}${member.photo}`} alt={`Portrait of ${member.name}`} loading="lazy" />
              ) : (
                <span aria-label={`${member.name} photo placeholder`}>
                  {member.name.split(' ').map((name) => name[0]).join('')}
                </span>
              )}
            </div>
            <div class="member-meta">
              <p>{member.role}</p>
              <h3>{member.name}</h3>
              <span>{period(member.start, member.end)}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="publication-preview section-pad" id="publications">
      <div class="publication-head">
        <div>
          <p class="eyebrow eyebrow-light"><span></span> Selected publications</p>
          <h2>Selected papers.</h2>
        </div>
        <a class="button button-light" href={`${base}/publications/`}>View all publications <span>↗</span></a>
      </div>
      <div class="publication-list publication-list-light">
        {selectedPubs.map((publication, index) => (
          <a class="publication-row" href={publication.adsurl} target="_blank" rel="noreferrer">
            <span class="publication-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{publication.title}</h3>
              <p>{formatAuthors(publication.authors, groupAuthorNames)}</p>
            </div>
            <p class="publication-venue">{publication.journal} · {publication.year}</p>
            <span class="publication-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="contact-section section-pad" id="contact">
      <p class="eyebrow"><span></span> Contact</p>
      <div>
        <h2>Interested in our research?</h2>
        <p>If you would like to ask about our work or discuss possible future opportunities, please feel free to get in touch.</p>
        <a class="button button-primary" href="mailto:yongjungkim@sejong.ac.kr">Send an email <span>↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>
