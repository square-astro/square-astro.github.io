---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import members from '../../data/members.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentMembers = members.filter((member) => member.status === 'current').sort((a, b) => a.order - b.order);
const formerMembers = members.filter((member) => member.status === 'former').sort((a, b) => a.order - b.order);

function period(start: string, end: string | null) {
  const display = (value: string) => value.replace('-', '.');
  return `${display(start)} — ${end ? display(end) : 'present'}`;
}
---

<SiteLayout title="People — SQuARE" description="Current members of the SQuARE Group at Sejong University.">
  <Header />
  <main>
    <PageHero
      eyebrow="People"
      title="Meet the SQuARE group."
      accent="SQuARE group."
      intro="We are observers and data explorers working together to understand quasars, black holes, and galaxies across cosmic history."
    />
    <section class="people-page section-pad">
      <div class="section-label"><span>01</span><h2>Current members</h2></div>
      <div class="people-directory">
        {currentMembers.map((member) => (
          <article class="person-entry">
            <div class="person-photo">
              {member.photo ? (
                <img src={`${base}${member.photo}`} alt={`Portrait of ${member.name}`} />
              ) : (
                <span>{member.name.split(' ').map((name) => name[0]).join('')}</span>
              )}
            </div>
            <div class="person-name">
              <p>{member.role}</p>
              <h3>{member.name}</h3>
            </div>
            <div class="person-details">
              <p class="person-period">{period(member.start, member.end)}</p>
              <p>{member.interests.join(' · ')}</p>
            </div>
            {member.profile ? (
              <a class="person-link" href={`${base}${member.profile}`} aria-label={`View ${member.name} profile`}>↗</a>
            ) : <span class="person-link person-link-muted">—</span>}
          </article>
        ))}
      </div>

      {formerMembers.length > 0 && (
        <>
          <div class="section-label section-label-secondary"><span>02</span><h2>Former members</h2></div>
          <div class="people-directory">
            {formerMembers.map((member) => (
              <article class="person-entry">
                <div class="person-name"><p>{member.role}</p><h3>{member.name}</h3></div>
                <div class="person-details"><p>{period(member.start, member.end)}</p></div>
              </article>
            ))}
          </div>
        </>
      )}
    </section>
  </main>
  <Footer />
</SiteLayout>
